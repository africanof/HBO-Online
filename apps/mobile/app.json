{
  "expo": {
    "name": "Huambo Online",
    "slug": "huambo-online",
    "owner": "africanofestos-team",
    "version": "0.5.5",
    "orientation": "portrait",
    "scheme": "huamboonline",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "ao.huamboonline.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3665F3"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "huamboonline.com",
              "pathPrefix": "/reservas/"
            },
            {
              "scheme": "https",
              "host": "huamboonline.com",
              "pathPrefix": "/combustivel/"
            },
            {
              "scheme": "https",
              "host": "huamboonline.com",
              "pathPrefix": "/eventos/bilhete/"
            },
            {
              "scheme": "https",
              "host": "huamboonline.com",
              "pathPrefix": "/profissionais/"
            },
            {
              "scheme": "https",
              "host": "huamboonline.com",
              "pathPrefix": "/empresas/"
            },
            {
              "scheme": "https",
              "host": "huamboonline.com",
              "pathPrefix": "/vendedor/"
            },
            {
              "scheme": "https",
              "host": "huamboonline.com",
              "pathPrefix": "/pracas/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "ao.huamboonline.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Huambo Online usa a galeria para escolher fotografias e vídeos dos seus anúncios e para pesquisar por fotografia.",
          "cameraPermission": "O Huambo Online usa a câmara para fotografar artigos, pesquisar por fotografia e fotografar documentos para verificar o perfil.",
          "microphonePermission": "O Huambo Online usa o microfone para gravar o som dos vídeos que envia no chat e nos anúncios."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Huambo Online usa a localização só quando carrega em «Usar a minha localização», para marcar no mapa onde fica o anúncio, a empresa ou a entrega, ver onde está no mapa ou enviar um ponto de encontro numa conversa."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Huambo Online usa o microfone só quando carrega em «🎤 Mensagem de voz» no chat.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Huambo Online usa a câmara para fotografar artigos e documentos, pesquisar por fotografia e ler o QR das reservas de combustível e dos bilhetes de eventos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3665F3",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Huambo Online usa o Face ID para desbloquear a APP, se escolher esta opção."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ac7a7f42-a58c-4ef1-8fb8-47678e81c6a5"
      }
    }
  }
}
