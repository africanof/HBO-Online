# Site (Next.js) — só chaves públicas
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço público do Site (Google, partilhas, mapa do site)
NEXT_PUBLIC_SITE_URL=
# Opcional: email de contacto mostrado nas páginas de ajuda
NEXT_PUBLIC_CONTACT_EMAIL=

# Site — só no servidor (opcionais)
# Cache partilhada das listas públicas (Fase 2, ver docs/infraestrutura/cache.md)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Impressões digitais extra do certificado Android (App Links), separadas por vírgulas
ANDROID_SHA256_FINGERPRINTS=

# APP (Expo) — só chaves públicas
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço do Site (links de confirmação e de recuperação de palavra-passe)
EXPO_PUBLIC_SITE_URL=https://huambo-online.vercel.app
